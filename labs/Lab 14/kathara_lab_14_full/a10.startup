# Configure a10 as an 8-port learning bridge.
for iface in eth0 eth1 eth2 eth3 eth4 eth5 eth6 eth7; do
    ip link set dev "$iface" address 08:00:4e:10:10:00
    ip addr flush dev "$iface"
    ip link set dev "$iface" promisc on
    ip link set dev "$iface" up
done

ip link add name sw0 type bridge
ip link set dev sw0 type bridge stp_state 1 priority 150

for iface in eth0 eth1 eth2 eth3 eth4 eth5 eth6 eth7; do
    ip link set dev "$iface" master sw0
done

ip link set dev sw0 up
