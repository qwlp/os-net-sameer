sysctl -w net.ipv4.ip_forward=1

ip link set dev eth0 address 02:60:ac:00:97:46
ip link set dev eth1 address 02:60:ac:00:50:55
ip addr add 172.28.97.46/29 dev eth0
ip addr add 10.227.150.55/16 dev eth1
ip link set eth0 up
ip link set eth1 up

ip route add 172.21.62.96/27 via 10.227.150.56
ip route add 172.19.78.0/23 via 10.227.150.58
ip route add 172.17.32.0/20 via 10.227.150.58
ip route add default via 10.227.150.254

